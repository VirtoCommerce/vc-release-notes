 "notes": {
  "forAnalyst": "Search delivered by Algolia, aimed at fast, typo-tolerant storefront search.",
  "forArchitect": "A Search adapter with two settings. The engine is hosted and its relevance model is its own, so tuning moves out of the platform and into Algolia's dashboard.",
  "forDeveloper": "Records are pushed from the platform's builders; per-record cost and index size are the constraints to design for, not query latency.",
  "owns": [],
  "reachForItWhen": [
   "This engine is the one your infrastructure already runs or your hosting provides",
   "Search behaviour or scale has outgrown the current provider",
   "You need the provider's own features — synonyms, analysers, vector search"
  ],
  "doNotReachForItWhen": [
   "Two providers at once: the platform binds one at a time",
   "You want to change what is indexed — that is the owning module's document builder",
   "The problem is stale results: that is indexation, not the engine"
